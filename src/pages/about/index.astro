---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE } from '@/config/site';
import { buildStandardPageSchema } from '@/lib/pageSchema';

const title = 'About PakRummyOfficial.com | Official Pak Rummy Information';
const description =
  "Who runs PakRummyOfficial.com, why it exists, and how it relates to the Pak Rummy game at pakrummy.com.";
const path = '/about/';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'About', href: path },
];
const jsonLd = buildStandardPageSchema({ title, description, path, crumbs, type: 'AboutPage' });
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>About PakRummyOfficial.com</h1>
      <p class="page-hero__summary">{SITE.positioning}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container container-prose">
      <h2>What we do</h2>
      <p>
        We publish verification status for the Pak Rummy Android app: download
        sources, file safety, app version tracking, payment guidance, and support information —
        clearly separating what we've confirmed from what we haven't.
      </p>

      <h2>What we don't do</h2>
      <ul>
        <li>This website doesn't process deposits, withdrawals, or account registration. Those happen inside the Pak Rummy app, available via <a href="https://pakrummy.com">pakrummy.com</a>.</li>
        <li>This website doesn't hold any player's account, balance, or personal data.</li>
        <li>We don't publish claims we can't back with a verifiable source — see our <a href="/editorial-policy/">editorial policy</a>.</li>
      </ul>

      <h2>How we handle mistakes</h2>
      <p>
        If we get something wrong, we correct it and log the correction — see our
        <a href="/corrections-policy/">corrections policy</a>. If you spot an error, tell us at
        <a href={`mailto:${SITE.editorialContactEmail}`}>{SITE.editorialContactEmail}</a>.
      </p>

      <div class="next-steps">
        <h2>Next steps</h2>
        <ul class="link-list">
          <li><a href="/editorial-policy/">Editorial policy</a></li>
          <li><a href="/authors/">Authors</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
