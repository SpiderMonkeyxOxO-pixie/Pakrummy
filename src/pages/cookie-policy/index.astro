---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Callout from '@/components/Callout.astro';
import { buildStandardPageSchema } from '@/lib/pageSchema';

const title = 'Cookie Policy | Pak Rummy Official';
const description = 'What cookies PakRummyOfficial.com uses today, and what we would use if analytics is enabled.';
const path = '/cookie-policy/';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Legal', href: '/terms/' },
  { name: 'Cookie Policy', href: path },
];
const effectiveDate = '17 August 2026';
const effectiveDateISO = '2026-08-17';
const jsonLd = buildStandardPageSchema({
  title,
  description,
  path,
  crumbs,
  datePublished: effectiveDateISO,
  dateModified: effectiveDateISO,
});
---

<BaseLayout title={title} description={description} path={path} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>Cookie Policy</h1>
      <p class="page-hero__summary">
        As published, this site sets no analytics or advertising cookies — no tracking ID has
        been configured. This page will be updated immediately if that changes.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container container-prose">
      <Callout title="Draft template pending review by qualified Pakistani legal counsel">
        <p>This is an original draft and has not yet been legally reviewed.</p>
      </Callout>

      <p class="fine-print">Effective date: {effectiveDate} &middot; Last revised: {effectiveDate}</p>

      <h2>Strictly necessary</h2>
      <p>Standard hosting-level logs are generated by any HTTPS web request and are not stored as browser cookies by this site.</p>

      <h2>Analytics (not currently active)</h2>
      <p>
        We have not configured Google Analytics, Google Tag Manager, or any other analytics
        service. If we do, this section will list the specific service, what it collects, and
        how to opt out, and we will request consent where required before it loads.
      </p>

      <h2>Advertising</h2>
      <p>This site does not run third-party advertising and sets no advertising cookies.</p>

      <h2>Managing cookies in your browser</h2>
      <p>You can clear or block cookies through your browser's privacy settings at any time.</p>

      <div class="next-steps">
        <h2>Related legal pages</h2>
        <ul class="link-list">
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms of use</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
