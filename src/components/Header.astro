---
import { PRIMARY_NAV } from '@/config/nav';
import { SITE } from '@/config/site';
import { downloadCtaLabel } from '@/lib/verification';

const ctaLabel = downloadCtaLabel(SITE.officialDownloadUrl);
---

<header class="site-header">
  <div class="site-header__accent" aria-hidden="true"></div>
  <div class="container site-header__row">
    <a href="/" class="site-header__brand">
      <img src="/images/pak-rummy-app-icon-64.webp" alt="" width="32" height="32" class="brand-mark" />
      <span>{SITE.siteName}</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {
          PRIMARY_NAV.map((item) => (
            <li>
              {item.children ? (
                <details class="nav-dropdown">
                  <summary>{item.label}</summary>
                  <ul class="nav-dropdown__panel">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href}>{item.label}</a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn-primary btn-sm" href="/download/">{ctaLabel}</a>
      <button type="button" class="menu-toggle" id="menu-toggle" aria-haspopup="dialog">
        <span class="visually-hidden">Open menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <dialog id="mobile-nav" class="mobile-nav" aria-label="Site navigation">
    <div class="mobile-nav__header">
      <span class="site-header__brand">
        <img src="/images/pak-rummy-app-icon-64.webp" alt="" width="28" height="28" class="brand-mark" />
        <span>{SITE.siteName}</span>
      </span>
      <button type="button" id="mobile-nav-close" class="menu-toggle">
        <span class="visually-hidden">Close menu</span>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="mobile-nav__list">
        {
          PRIMARY_NAV.map((item) => (
            <li>
              {item.children ? (
                <details>
                  <summary>{item.label}</summary>
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href}>{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a href={item.href}>{item.label}</a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </dialog>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('mobile-nav-close');
  const dialog = document.getElementById('mobile-nav') as HTMLDialogElement | null;

  toggle?.addEventListener('click', () => {
    dialog?.showModal();
  });

  closeBtn?.addEventListener('click', () => {
    dialog?.close();
  });

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });

  dialog?.addEventListener('close', () => {
    toggle?.focus();
  });
</script>

<style>
  .site-header {
    background: rgba(3, 23, 19, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .site-header__accent {
    height: 2px;
    background: linear-gradient(90deg, var(--color-emerald-strong) 0%, var(--color-gold) 50%, var(--color-emerald-strong) 100%);
    opacity: 0.7;
  }

  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-width: 0;
    padding-block: var(--space-3);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    color: var(--color-ivory);
    text-decoration: none;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .site-header__brand span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .brand-mark {
    border-radius: 7px;
    flex-shrink: 0;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav > ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--space-5);
    align-items: center;
  }

  .site-header__nav a {
    color: var(--color-ivory);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--color-gold-strong);
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    cursor: pointer;
    color: var(--color-ivory);
    font-weight: 600;
    font-size: 0.95rem;
    list-style: none;
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown[open] summary {
    color: var(--color-gold-strong);
  }

  .nav-dropdown__panel {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    min-width: 220px;
    list-style: none;
    margin: 0;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  .nav-dropdown__panel li + li {
    margin-top: var(--space-1);
  }

  .nav-dropdown__panel a {
    display: block;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  .nav-dropdown__panel a:hover,
  .nav-dropdown__panel a:focus-visible {
    background: rgba(245, 185, 66, 0.1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .btn-sm {
    min-height: 40px;
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    display: none;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-ivory);
    cursor: pointer;
  }

  .mobile-nav {
    border: none;
    padding: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    background: var(--color-navy);
    color: var(--color-ivory);
  }

  .mobile-nav::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }

  .mobile-nav__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-nav__list {
    list-style: none;
    margin: 0;
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .mobile-nav__list > li > a,
  .mobile-nav__list summary {
    display: block;
    padding: var(--space-3) var(--space-2);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-ivory);
    text-decoration: none;
    cursor: pointer;
    min-height: 44px;
  }

  .mobile-nav__list summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__list details ul {
    list-style: none;
    margin: 0;
    padding-left: var(--space-4);
  }

  .mobile-nav__list details a {
    display: block;
    padding: var(--space-2);
    color: var(--color-slate);
    text-decoration: none;
    font-weight: 500;
    min-height: 44px;
  }

  .mobile-nav__list a:hover,
  .mobile-nav__list a:focus-visible {
    color: var(--color-gold-strong);
  }

  @media (min-width: 1024px) {
    .site-header__nav {
      display: block;
    }

    .btn-sm {
      display: inline-flex;
    }

    .menu-toggle {
      display: none;
    }
  }
</style>
