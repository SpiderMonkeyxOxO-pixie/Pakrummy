---
import { FOOTER_NAV } from '@/config/nav';
import { SITE } from '@/config/site';
import { isVerifiedFact } from '@/lib/verification';

const year = new Date().getFullYear();
const socialProfiles = isVerifiedFact(SITE.operatorSocialProfiles) ? SITE.operatorSocialProfiles.value : [];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-header__brand">
          <img src="/images/pak-rummy-app-icon.png" alt="" width="28" height="28" style="border-radius: 6px;" />
          <span>{SITE.siteName}</span>
        </a>
        <p>{SITE.positioning}</p>
        <p class="site-footer__contact">
          Editorial &amp; legal contact: <a href={`mailto:${SITE.editorialContactEmail}`}>{SITE.editorialContactEmail}</a>
        </p>
        {
          socialProfiles.length > 0 && (
            <p class="site-footer__social">
              Operator-confirmed:{' '}
              {socialProfiles.map((profile, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={profile.url} target="_blank" rel="noopener noreferrer">
                    {profile.platform}
                  </a>
                </>
              ))}
            </p>
          )
        }
      </div>

      <div class="site-footer__columns">
        {
          FOOTER_NAV.map((column) => (
            <div>
              <h2>{column.heading}</h2>
              <ul>
                {column.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="site-footer__verification">
      <p>
        This is the official information website of the Pak Rummy team; the game itself is at
        <a href="https://pakrummy.com">pakrummy.com</a>. This website does not process deposits,
        withdrawals, or account credentials. Facts we haven't confirmed are labelled "Not yet
        publicly verified" rather than assumed. See our
        <a href="/editorial-policy/">editorial policy</a> and <a href="/official-domains/">official
        domains guidance</a>.
      </p>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} {SITE.publisherName}. All rights reserved.</p>
      <a href="/sitemap/">HTML sitemap</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-raised);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-7) var(--space-5);
    margin-top: var(--space-8);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-6);
  }

  .site-footer__brand p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .site-footer__contact a,
  .site-footer__social a {
    color: var(--color-gold-strong);
  }

  .site-footer__social {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-top: -0.5rem;
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }

  .site-footer__columns h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .site-footer__columns ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__columns a {
    color: var(--color-ivory);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .site-footer__columns a:hover,
  .site-footer__columns a:focus-visible {
    color: var(--color-gold-strong);
  }

  .site-footer__verification {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
  }

  .site-footer__verification p {
    max-width: 80ch;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .site-footer__bottom a {
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .site-footer__columns {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 260px 1fr;
    }

    .site-footer__columns {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
