---
import type { Verified } from '@/config/site';
import { factText, isFactObject, factStatusTone, type StatusTone } from '@/lib/verification';

interface FactRow {
  label: string;
  fact: Verified<unknown> | string;
  formatter?: (value: never) => string;
}

interface Props {
  caption?: string;
  rows: FactRow[];
}

const { caption, rows } = Astro.props;

const badgeLabel: Record<StatusTone, string> = {
  verified: 'Verified',
  'operator-stated': 'Operator-stated',
  pending: 'Unverified',
  unavailable: 'Unverified',
};

interface PreparedRow {
  label: string;
  displayValue: string;
  isFact: boolean;
  tone: StatusTone;
}

const preparedRows: PreparedRow[] = rows.map((row: FactRow) => {
  const factIsObject = isFactObject(row.fact);
  if (!factIsObject) {
    return { label: row.label, displayValue: row.fact as string, isFact: false, tone: 'verified' };
  }
  const fact = row.fact as Verified<unknown>;
  const formatter = row.formatter as ((v: unknown) => string) | undefined;
  return {
    label: row.label,
    displayValue: factText(fact, formatter),
    isFact: true,
    tone: factStatusTone(fact),
  };
});
---

<div class="scroll-table">
  <table class="fact-table">
    {caption && <caption>{caption}</caption>}
    <tbody>
      {
        preparedRows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td>
              <span>{row.displayValue}</span>
              {row.isFact && (
                <span class={`badge badge-${row.tone === 'unavailable' ? 'unverified' : row.tone}`}>
                  {badgeLabel[row.tone]}
                </span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  td span:first-child {
    display: block;
    margin-bottom: 0.35rem;
  }
</style>
