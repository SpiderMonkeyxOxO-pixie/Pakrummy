---
import { Image } from 'astro:assets';
import CTAButton from '@/components/CTAButton.astro';
import PakPatternBackground from '@/components/PakPatternBackground.astro';
import pakLoadingScreen from '@/assets/screenshots/pak-rummy-loading-screen.png';
import { SITE } from '@/config/site';
import { downloadCtaLabel, isVerifiedFact } from '@/lib/verification';

const ctaLabel = downloadCtaLabel(SITE.officialDownloadUrl);
const versionKnown = isVerifiedFact(SITE.appVersion);
const androidKnown = isVerifiedFact(SITE.appMinAndroidVersion);
const downloadVerified = isVerifiedFact(SITE.officialDownloadUrl);
---

<section class="hero">
  <PakPatternBackground variant="hero" />
  <div class="container hero__inner">
    <div class="hero__copy reveal">
      <p class="eyebrow">Pakistan Player Resource &middot; Independent</p>
      <h1>Pak Rummy App Guide for Players in Pakistan</h1>
      <p class="hero__lede">
        Check Pak Rummy download availability, Android requirements, bonuses, safety information,
        and player guides prepared specifically for players in Pakistan. We're an independent
        resource — not the game operator — and we never process deposits, withdrawals, or account
        data.
      </p>

      <div class="hero__actions">
        <CTAButton href="/download/" label={ctaLabel} variant="primary" />
        <CTAButton href="/guides/" label="Explore Player Guides" variant="secondary" />
      </div>

      <ul class="hero__chips">
        <li class="chip">
          <span class={`chip-dot ${downloadVerified ? 'chip-dot--verified' : 'chip-dot--pending'}`} />
          {downloadVerified ? 'Self-hosted & checksummed' : 'Download source pending'}
        </li>
        <li class="chip">
          <span class={`chip-dot ${versionKnown ? 'chip-dot--verified' : 'chip-dot--pending'}`} />
          {versionKnown ? `Version ${SITE.appVersion.value}` : 'Version pending'}
        </li>
        <li class="chip">
          <span class={`chip-dot ${androidKnown ? 'chip-dot--verified' : 'chip-dot--pending'}`} />
          {androidKnown ? 'Android 5.0+' : 'Android requirement pending'}
        </li>
        <li class="chip chip-policy">18+ only</li>
      </ul>

      <p class="hero__reviewed">Last reviewed 17 August 2026 by the PakRummyOfficial.com editorial team.</p>
    </div>

    <div class="hero__visual reveal">
      <Image
        src={pakLoadingScreen}
        alt="Real screenshot of the Pak Rummy app's loading screen"
        width={480}
        loading="eager"
        fetchpriority="high"
        class="hero__phone-shot"
      />

      <div class="hero__float-card hero__float-card--1 glass-panel float-anim" aria-hidden="true">
        <span class="chip-dot chip-dot--verified" />
        Rummy
      </div>
      <div class="hero__float-card hero__float-card--2 glass-panel float-anim" aria-hidden="true">
        <span class="chip-dot chip-dot--verified" />
        Teen Patti
      </div>
      <div class="hero__float-card hero__float-card--3 glass-panel float-anim" aria-hidden="true">
        <span class="chip-dot chip-dot--verified" />
        Aviator
      </div>
    </div>
  </div>
</section>

<script>
  const revealTargets = document.querySelectorAll('.reveal');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion || !('IntersectionObserver' in window) || revealTargets.length === 0) {
    revealTargets.forEach((el) => el.classList.add('is-visible'));
  } else {
    // Only now do reveal targets start hidden (see the .js-ready.reveal-armed
    // gate in global.css) — content stays visible-by-default up to this point.
    document.documentElement.classList.add('reveal-armed');

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.15 }
    );
    revealTargets.forEach((el) => observer.observe(el));

    // Safety net: force everything visible after 3s regardless, so a stuck
    // or missed observer callback can never hide content indefinitely.
    setTimeout(() => {
      revealTargets.forEach((el) => el.classList.add('is-visible'));
    }, 3000);
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 100% at 80% 0%, rgba(16, 185, 129, 0.18) 0%, transparent 55%),
      linear-gradient(180deg, #052a21 0%, var(--color-navy) 65%);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-7) var(--space-8);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__copy {
    max-width: 620px;
    min-width: 0;
  }

  .hero__lede {
    font-size: 1.05rem;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .hero__chips {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* A fixed policy note, not a verification status — no status dot. */
  .chip-policy {
    border-color: var(--status-pending-border);
    color: var(--color-gold-strong);
  }

  .hero__reviewed {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .hero__visual {
    position: relative;
    min-width: 0;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__phone-shot {
    position: relative;
    width: 290px;
    height: auto;
    /* drop-shadow (not box-shadow) follows the image's actual alpha shape,
       so the transparent margins around the phone stay fully transparent
       instead of showing a rectangular halo. */
    filter: drop-shadow(0 18px 34px rgba(1, 8, 6, 0.55)) drop-shadow(0 0 26px rgba(16, 185, 129, 0.3));
    transition: transform 0.25s ease;
  }

  .hero__phone-shot:hover {
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__phone-shot:hover {
      transform: none;
    }
  }

  @media (min-width: 900px) {
    .hero__phone-shot {
      width: 380px;
    }
  }

  .hero__float-card {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-ivory);
  }

  .hero__float-card--1 {
    top: 4%;
    left: -2%;
    animation-delay: 0.2s;
  }

  .hero__float-card--2 {
    bottom: 18%;
    right: -4%;
    animation-delay: 1.1s;
  }

  .hero__float-card--3 {
    bottom: -2%;
    left: 8%;
    animation-delay: 2s;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
